# Higgsfield Cloud credentials — copy this file to `.env` and fill in.
# Get these from https://cloud.higgsfield.ai/ → dashboard → API section.
# `.env` is gitignored; never commit real keys.

HF_API_KEY=your-api-key-here
HF_API_SECRET=your-api-secret-here

# The image-to-video model id and the argument key it expects for the start
# image vary by model. Open your dashboard's API example for the DoP /
# image-to-video model and copy the exact "application" id here.
HF_APPLICATION=/v1/image2video/dop
HF_MODEL=dop-turbo
